digraph G {
  graph [fontname="Crimson Text", nodesep=0.45, ranksep=0.55, pad=0.1, bgcolor="white"];
  node [shape=plain, fontname="Crimson Text", fontsize=10];
  edge [fontname="Crimson Text", fontsize=8.5, arrowsize=0.7, penwidth=0.8];
  SupportTeam [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" style="rounded"><tr><td bgcolor="gray95"><b>SupportTeam</b></td></tr><hr/><tr><td align="left" balign="left">-id: UUID<br align="left"/>-name: String<br align="left"/>-leadId: UUID<br align="left"/>-categories: Set&lt;Category&gt;<br align="left"/></td></tr><hr/><tr><td align="left" balign="left">+availableMembers(): List&lt;TeamMember&gt;<br align="left"/>+leastLoadedMember(): TeamMember<br align="left"/></td></tr></table>>];
  TeamMember [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" style="rounded"><tr><td bgcolor="gray95"><b>TeamMember</b></td></tr><hr/><tr><td align="left" balign="left">-agentId: UUID<br align="left"/>-available: boolean<br align="left"/>-openTickets: int<br align="left"/>-maxOpenTickets: int<br align="left"/></td></tr><hr/><tr><td align="left" balign="left">+canTakeMore(): boolean<br align="left"/></td></tr></table>>];
  RoutingRule [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" style="rounded"><tr><td bgcolor="gray95"><b>RoutingRule</b></td></tr><hr/><tr><td align="left" balign="left">-id: UUID<br align="left"/>-category: Category<br align="left"/>-minPriority: Priority<br align="left"/>-teamId: UUID<br align="left"/>-order: int<br align="left"/></td></tr><hr/><tr><td align="left" balign="left">+matches(category: Category, priority: Priority): boolean<br align="left"/></td></tr></table>>];
  SlaPolicy [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" style="rounded"><tr><td bgcolor="gray95"><b>SlaPolicy</b></td></tr><hr/><tr><td align="left" balign="left">-id: UUID<br align="left"/>-priority: Priority<br align="left"/>-firstResponse: Duration<br align="left"/>-resolution: Duration<br align="left"/>-businessHoursOnly: boolean<br align="left"/></td></tr><hr/><tr><td align="left" balign="left">+dueAt(from: Instant, calendar: BusinessCalendar): Instant<br align="left"/></td></tr></table>>];
  SlaClock [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" style="rounded"><tr><td bgcolor="gray95"><b>SlaClock</b></td></tr><hr/><tr><td align="left" balign="left">-ticketId: UUID<br align="left"/>-policyId: UUID<br align="left"/>-startedAt: Instant<br align="left"/>-firstResponseDueAt: Instant<br align="left"/>-resolutionDueAt: Instant<br align="left"/>-pausedAt: Instant<br align="left"/>-pausedTotal: Duration<br align="left"/>-state: ClockState<br align="left"/>-atRiskNotified: boolean<br align="left"/></td></tr><hr/><tr><td align="left" balign="left">+pause(now: Instant): void<br align="left"/>+resume(now: Instant): void<br align="left"/>+recordFirstResponse(now: Instant): void<br align="left"/>+stop(now: Instant): void<br align="left"/>+isBreached(now: Instant): boolean<br align="left"/></td></tr></table>>];
  BusinessCalendar [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" style="rounded"><tr><td bgcolor="gray95"><b>BusinessCalendar</b></td></tr><hr/><tr><td align="left" balign="left">-timeZone: ZoneId<br align="left"/>-workdayStart: LocalTime<br align="left"/>-workdayEnd: LocalTime<br align="left"/>-holidays: Set&lt;LocalDate&gt;<br align="left"/></td></tr><hr/><tr><td align="left" balign="left">+add(from: Instant, d: Duration): Instant<br align="left"/></td></tr></table>>];
  ClockState [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" style="rounded"><tr><td bgcolor="gray95"><font point-size="8">&laquo;enumeration&raquo;</font><br/><b>ClockState</b></td></tr><hr/><tr><td align="left" balign="left">RUNNING<br align="left"/>PAUSED<br align="left"/>MET<br align="left"/>BREACHED<br align="left"/></td></tr></table>>];
  Ticket [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" style="rounded" color="gray55" bgcolor="gray92"><tr><td><font color="gray40" point-size="8">&laquo;external&raquo;</font></td></tr><tr><td><font color="gray35">Ticket</font></td></tr></table>>];
  Employee [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" style="rounded" color="gray55" bgcolor="gray92"><tr><td><font color="gray40" point-size="8">&laquo;external&raquo;</font></td></tr><tr><td><font color="gray35">Employee</font></td></tr></table>>];
  SupportTeam -> TeamMember [arrowhead=none, arrowtail=diamond, dir=both, taillabel="1", headlabel="1..*", label="", style=solid];
  RoutingRule -> SupportTeam [arrowhead=vee, arrowtail=none, dir=both, taillabel="0..*", headlabel="1", label=" routes to", style=solid];
  SlaClock -> SlaPolicy [arrowhead=vee, arrowtail=none, dir=both, taillabel="0..*", headlabel="1", label=" follows", style=solid];
  SlaPolicy -> BusinessCalendar [style=dashed, arrowhead=vee, label="uses"];
  SlaClock -> ClockState [style=dashed, arrowhead=vee, label=""];
  SlaClock -> Ticket [style=dashed, arrowhead=vee, label="ticketId «ref by ID»", color="gray30", fontcolor="gray25"];
  TeamMember -> Employee [style=dashed, arrowhead=vee, label="agentId «ref by ID»", color="gray30", fontcolor="gray25"];
}
