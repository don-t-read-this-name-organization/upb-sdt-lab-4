digraph G {
  graph [fontname="Crimson Text", nodesep=0.45, ranksep=0.55, pad=0.1, bgcolor="white"];
  node [shape=plain, fontname="Crimson Text", fontsize=10];
  edge [fontname="Crimson Text", fontsize=8.5, arrowsize=0.7, penwidth=0.8];
  TicketFact [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" style="rounded"><tr><td bgcolor="gray95"><b>TicketFact</b></td></tr><hr/><tr><td align="left" balign="left">-ticketId: UUID<br align="left"/>-teamId: UUID<br align="left"/>-assigneeId: UUID<br align="left"/>-category: Category<br align="left"/>-priority: Priority<br align="left"/>-status: TicketStatus<br align="left"/>-createdAt: Instant<br align="left"/>-firstRespondedAt: Instant<br align="left"/>-resolvedAt: Instant<br align="left"/>-pausedTotal: Duration<br align="left"/>-reopenCount: int<br align="left"/>-firstResponseMet: Boolean<br align="left"/>-resolutionMet: Boolean<br align="left"/>-lastEventId: UUID<br align="left"/></td></tr><hr/><tr><td align="left" balign="left">+apply(event: TicketEvent): void<br align="left"/>+firstResponseTime(): Duration<br align="left"/>+resolutionTime(): Duration<br align="left"/></td></tr></table>>];
  DailyTeamMetric [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" style="rounded"><tr><td bgcolor="gray95"><b>DailyTeamMetric</b></td></tr><hr/><tr><td align="left" balign="left">-day: LocalDate<br align="left"/>-teamId: UUID<br align="left"/>-created: int<br align="left"/>-resolved: int<br align="left"/>-backlogAtEndOfDay: int<br align="left"/>-medianFirstResponse: Duration<br align="left"/>-p90Resolution: Duration<br align="left"/>-slaCompliance: double<br align="left"/>-reopenRate: double<br align="left"/></td></tr><hr/><tr><td align="left" balign="left">+merge(other: DailyTeamMetric): DailyTeamMetric<br align="left"/></td></tr></table>>];
  ReportQuery [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" style="rounded"><tr><td bgcolor="gray95"><b>ReportQuery</b></td></tr><hr/><tr><td align="left" balign="left">-from: LocalDate<br align="left"/>-to: LocalDate<br align="left"/>-teamIds: Set&lt;UUID&gt;<br align="left"/>-categories: Set&lt;Category&gt;<br align="left"/>-groupBy: Grouping<br align="left"/></td></tr><hr/><tr><td align="left" balign="left">+authorize(viewerId: UUID, roles: Set&lt;Role&gt;): void<br align="left"/></td></tr></table>>];
  ProcessedEvent [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" style="rounded"><tr><td bgcolor="gray95"><b>ProcessedEvent</b></td></tr><hr/><tr><td align="left" balign="left">-eventId: UUID<br align="left"/>-processedAt: Instant<br align="left"/></td></tr><hr/><tr><td align="left" balign="left"> </td></tr></table>>];
  Grouping [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" style="rounded"><tr><td bgcolor="gray95"><font point-size="8">&laquo;enumeration&raquo;</font><br/><b>Grouping</b></td></tr><hr/><tr><td align="left" balign="left">DAY<br align="left"/>WEEK<br align="left"/>MONTH<br align="left"/>TEAM<br align="left"/>CATEGORY<br align="left"/>AGENT<br align="left"/></td></tr></table>>];
  Ticket [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" style="rounded" color="gray55" bgcolor="gray92"><tr><td><font color="gray40" point-size="8">&laquo;external&raquo;</font></td></tr><tr><td><font color="gray35">Ticket</font></td></tr></table>>];
  DailyTeamMetric -> TicketFact [arrowhead=vee, arrowtail=none, dir=both, taillabel="", headlabel="0..*", label=" aggregates", style=solid];
  ReportQuery -> DailyTeamMetric [style=dashed, arrowhead=vee, label="reads"];
  ReportQuery -> Grouping [style=dashed, arrowhead=vee, label=""];
  TicketFact -> Ticket [style=dashed, arrowhead=vee, label="ticketId «ref by ID»", color="gray30", fontcolor="gray25"];
}
