digraph G {
  graph [fontname="Crimson Text", nodesep=0.45, ranksep=0.55, pad=0.1, bgcolor="white"];
  node [shape=plain, fontname="Crimson Text", fontsize=10];
  edge [fontname="Crimson Text", fontsize=8.5, arrowsize=0.7, penwidth=0.8];
  rankdir=LR; ranksep=0.7;
  Ticket [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" style="rounded"><tr><td bgcolor="gray95"><b>Ticket</b></td></tr><hr/><tr><td align="left" balign="left">-id: UUID<br align="left"/>-number: String<br align="left"/>-requesterId: UUID<br align="left"/>-assigneeId: UUID<br align="left"/>-teamId: UUID<br align="left"/>-title: String<br align="left"/>-description: String<br align="left"/>-category: Category<br align="left"/>-priority: Priority<br align="left"/>-status: TicketStatus<br align="left"/>-version: long<br align="left"/>-createdAt: Instant<br align="left"/>-firstRespondedAt: Instant<br align="left"/>-resolvedAt: Instant<br align="left"/>-closedAt: Instant<br align="left"/>-resolutionDueAt: Instant<br align="left"/>-reopenCount: int<br align="left"/></td></tr><hr/><tr><td align="left" balign="left">+assign(teamId: UUID, assigneeId: UUID, dueAt: Instant): void<br align="left"/>+changeStatus(to: TicketStatus, by: UUID,<br align="left"/>      expectedVersion: long, reason: String): StatusChange<br align="left"/>+addComment(authorId: UUID, body: String,<br align="left"/>      visibility: Visibility): Comment<br align="left"/>+canView(userId: UUID, roles: Set&lt;Role&gt;): boolean<br align="left"/>+canTransition(to: TicketStatus, roles: Set&lt;Role&gt;): boolean<br align="left"/></td></tr></table>>];
  Comment [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" style="rounded"><tr><td bgcolor="gray95"><b>Comment</b></td></tr><hr/><tr><td align="left" balign="left">-id: UUID<br align="left"/>-authorId: UUID<br align="left"/>-body: String<br align="left"/>-visibility: Visibility<br align="left"/>-createdAt: Instant<br align="left"/></td></tr><hr/><tr><td align="left" balign="left">+isVisibleTo(roles: Set&lt;Role&gt;): boolean<br align="left"/></td></tr></table>>];
  StatusChange [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" style="rounded"><tr><td bgcolor="gray95"><b>StatusChange</b></td></tr><hr/><tr><td align="left" balign="left">-id: UUID<br align="left"/>-from: TicketStatus<br align="left"/>-to: TicketStatus<br align="left"/>-changedBy: UUID<br align="left"/>-changedAt: Instant<br align="left"/>-reason: String<br align="left"/></td></tr><hr/><tr><td align="left" balign="left"> </td></tr></table>>];
  Attachment [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" style="rounded"><tr><td bgcolor="gray95"><b>Attachment</b></td></tr><hr/><tr><td align="left" balign="left">-id: UUID<br align="left"/>-uploadedBy: UUID<br align="left"/>-fileName: String<br align="left"/>-contentType: String<br align="left"/>-sizeBytes: long<br align="left"/>-storageKey: String<br align="left"/>-scanStatus: ScanStatus<br align="left"/></td></tr><hr/><tr><td align="left" balign="left">+uploadUrl(ttl: Duration): URL<br align="left"/>+downloadUrl(ttl: Duration): URL<br align="left"/></td></tr></table>>];
  TicketStatus [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" style="rounded"><tr><td bgcolor="gray95"><font point-size="8">&laquo;enumeration&raquo;</font><br/><b>TicketStatus</b></td></tr><hr/><tr><td align="left" balign="left">OPEN<br align="left"/>IN_PROGRESS<br align="left"/>ON_HOLD<br align="left"/>RESOLVED<br align="left"/>CLOSED<br align="left"/></td></tr></table>>];
  Priority [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" style="rounded"><tr><td bgcolor="gray95"><font point-size="8">&laquo;enumeration&raquo;</font><br/><b>Priority</b></td></tr><hr/><tr><td align="left" balign="left">LOW<br align="left"/>MEDIUM<br align="left"/>HIGH<br align="left"/>CRITICAL<br align="left"/></td></tr></table>>];
  Category [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" style="rounded"><tr><td bgcolor="gray95"><font point-size="8">&laquo;enumeration&raquo;</font><br/><b>Category</b></td></tr><hr/><tr><td align="left" balign="left">HARDWARE<br align="left"/>SOFTWARE<br align="left"/>NETWORK<br align="left"/>ACCESS<br align="left"/>EMAIL<br align="left"/>OTHER<br align="left"/></td></tr></table>>];
  Visibility [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" style="rounded"><tr><td bgcolor="gray95"><font point-size="8">&laquo;enumeration&raquo;</font><br/><b>Visibility</b></td></tr><hr/><tr><td align="left" balign="left">PUBLIC<br align="left"/>INTERNAL<br align="left"/></td></tr></table>>];
  ScanStatus [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" style="rounded"><tr><td bgcolor="gray95"><font point-size="8">&laquo;enumeration&raquo;</font><br/><b>ScanStatus</b></td></tr><hr/><tr><td align="left" balign="left">PENDING<br align="left"/>CLEAN<br align="left"/>INFECTED<br align="left"/></td></tr></table>>];
  Employee [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" style="rounded" color="gray55" bgcolor="gray92"><tr><td><font color="gray40" point-size="8">&laquo;external&raquo;</font></td></tr><tr><td><font color="gray35">Employee</font></td></tr></table>>];
  SupportTeam [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" style="rounded" color="gray55" bgcolor="gray92"><tr><td><font color="gray40" point-size="8">&laquo;external&raquo;</font></td></tr><tr><td><font color="gray35">SupportTeam</font></td></tr></table>>];
  Ticket -> Comment [arrowhead=none, arrowtail=diamond, dir=both, taillabel="1", headlabel="0..*", label="", style=solid];
  Ticket -> StatusChange [arrowhead=none, arrowtail=diamond, dir=both, taillabel="1", headlabel="1..*", label="", style=solid];
  Ticket -> Attachment [arrowhead=none, arrowtail=diamond, dir=both, taillabel="1", headlabel="0..*", label="", style=solid];
  Ticket -> TicketStatus [style=dashed, arrowhead=vee, label=""];
  Ticket -> Priority [style=dashed, arrowhead=vee, label=""];
  Ticket -> Category [style=dashed, arrowhead=vee, label=""];
  Comment -> Visibility [style=dashed, arrowhead=vee, label=""];
  Attachment -> ScanStatus [style=dashed, arrowhead=vee, label=""];
  Ticket -> Employee [style=dashed, arrowhead=vee, label="requesterId, assigneeId «ref by ID»", color="gray30", fontcolor="gray25"];
  Ticket -> SupportTeam [style=dashed, arrowhead=vee, label="teamId «ref by ID»", color="gray30", fontcolor="gray25"];
}
